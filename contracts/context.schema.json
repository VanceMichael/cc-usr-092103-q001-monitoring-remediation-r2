{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "领域上下文",
  "type": "object",
  "required": [
    "domain",
    "version",
    "facts",
    "sample_id",
    "generated_at",
    "institutions",
    "operators",
    "instruments",
    "stage_deadlines",
    "permission_matrix"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "资料导出时刻，作为基础资料的系统已知起点"
    },
    "institutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["institution_id", "name", "qualifications"],
        "properties": {
          "institution_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "credit_code": {"type": "string"},
          "qualifications": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["qualification_id", "type", "valid_from", "status"],
              "properties": {
                "qualification_id": {"type": "string", "minLength": 1},
                "type": {"type": "string", "minLength": 1},
                "certificate_no": {"type": "string"},
                "valid_from": {"type": "string", "format": "date-time"},
                "valid_to": {"type": ["string", "null"], "format": "date-time"},
                "status": {"type": "string", "enum": ["有效", "暂停", "注销"]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "operators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operator_id", "name", "institution_id", "authorizations"],
        "properties": {
          "operator_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "institution_id": {"type": "string", "minLength": 1},
          "authorizations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["authorization_id", "scope", "valid_from"],
              "properties": {
                "authorization_id": {"type": "string", "minLength": 1},
                "scope": {"type": "string", "minLength": 1},
                "valid_from": {"type": "string", "format": "date-time"},
                "valid_to": {"type": ["string", "null"], "format": "date-time"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["instrument_id", "name", "institution_id", "calibrations"],
        "properties": {
          "instrument_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "institution_id": {"type": "string", "minLength": 1},
          "calibrations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["calibration_id", "calibrated_at", "valid_until", "certificate_no"],
              "properties": {
                "calibration_id": {"type": "string", "minLength": 1},
                "calibrated_at": {"type": "string", "format": "date-time"},
                "valid_until": {"type": "string", "format": "date-time"},
                "certificate_no": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "stage_deadlines": {
      "type": "array",
      "minItems": 1,
      "description": "自查整改各阶段的法定办理期限，按顺序推进",
      "items": {
        "type": "object",
        "required": ["stage", "name", "duration_days"],
        "properties": {
          "stage": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "duration_days": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "permission_matrix": {
      "type": "object",
      "description": "处置权限矩阵：各类处置由哪些角色依何程序推进",
      "required": ["false_report", "perfunctory_rectification", "review_failed", "suspected_crime"],
      "properties": {
        "false_report": {"$ref": "#/$defs/simple_disposition"},
        "perfunctory_rectification": {"$ref": "#/$defs/simple_disposition"},
        "review_failed": {"$ref": "#/$defs/simple_disposition"},
        "suspected_crime": {
          "type": "object",
          "required": ["label", "action", "propose_roles", "approve_roles", "execute_roles"],
          "properties": {
            "label": {"type": "string"},
            "action": {"type": "string"},
            "propose_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "approve_roles": {"type": "array", "minItems": 2, "items": {"type": "string"}},
            "execute_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "simple_disposition": {
      "type": "object",
      "required": ["label", "action", "roles"],
      "properties": {
        "label": {"type": "string"},
        "action": {"type": "string"},
        "roles": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
